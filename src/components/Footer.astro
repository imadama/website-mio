---
---
<footer id="footer">
  <div class="footer-ornament ornament" aria-hidden="true" style="margin-bottom: 40px;">
    <span class="line" style="flex: 1 1 auto;"></span>
    <span class="diamond">✦</span>
    <span class="line" style="flex: 1 1 auto;"></span>
  </div>

  <div class="footer-logo" aria-label="MIO">MIO</div>
  <p class="footer-sub">Dessert Lounge &nbsp;·&nbsp; Gorinchem</p>

  <address class="footer-contact">
    <a
      href="https://maps.google.com/?q=Kon.+Wilhelminalaan+42,+4205+EX+Gorinchem"
      target="_blank"
      rel="noopener noreferrer"
      class="footer-address"
      aria-label="Bekijk adres op Google Maps"
    >
      Kon. Wilhelminalaan 42<br />4205 EX Gorinchem
    </a>
    <a href="mailto:info@mio-gorinchem.nl" aria-label="Stuur een e-mail naar MIO Dessert Lounge">
      info@mio-gorinchem.nl
    </a>
  </address>

  <nav class="footer-socials" aria-label="Sociale media">
    <a href="#" class="footer-social-link" aria-label="MIO op Instagram" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true">
        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
        <circle cx="12" cy="12" r="5"/>
        <circle cx="17.5" cy="6.5" r="0.5" fill="currentColor" stroke="none"/>
      </svg>
    </a>
    <a href="#" class="footer-social-link" aria-label="MIO op TikTok" rel="noopener">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
        aria-hidden="true">
        <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"/>
      </svg>
    </a>
  </nav>

  <p class="footer-copy">© 2026 Mio Dessert Lounge</p>
</footer>

<style>
  #footer {
    padding: 72px 24px 56px;
    text-align: center;
    position: relative;
    background:
      radial-gradient(ellipse 80% 60% at 50% 100%, rgba(61, 40, 23, 0.06) 0%, transparent 65%),
      var(--cream-base);
  }

  .footer-logo {
    font-family: var(--serif-display);
    font-size: 36px;
    font-weight: 400;
    letter-spacing: 0.14em;
    background: linear-gradient(135deg, #D4B98C 0%, #B8956A 35%, #E8D4A8 55%, #B8956A 75%, #8B6F47 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 10px;
  }

  .footer-sub {
    font-family: var(--serif-body);
    font-size: 15px;
    font-weight: 300;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brown-soft);
    margin-bottom: 28px;
  }

  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-bottom: 28px;
    font-style: normal;
  }
  .footer-contact a {
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--gold-rich);
    text-decoration: none;
    transition: color 0.25s ease;
    text-align: center;
    line-height: 1.6;
  }
  .footer-contact a:hover { color: var(--brown-deep); }

  .footer-socials {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 36px;
  }

  .footer-social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(184, 149, 106, 0.45);
    color: var(--gold-rich);
    text-decoration: none;
    transition: border-color 0.3s ease, color 0.3s ease;
  }
  .footer-social-link:hover {
    border-color: var(--gold-rich);
    color: var(--brown-deep);
  }
  .footer-social-link:focus-visible {
    outline: 2px solid var(--gold-rich);
    outline-offset: 3px;
  }

  .footer-copy {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--brown-soft);
    opacity: 0.65;
  }
</style>
