---
import { tijden, currentStatus } from '../lib/openingstijden.js';
import OpenStatus from './OpenStatus.astro';

// Vandaag-markering server-side; OpenStatus houdt 'm daarna in de browser bij.
const { day: vandaag } = currentStatus();
---
<section id="tijden" aria-labelledby="tijden-heading">
  <div class="section-inner narrow">
    <div class="reveal" style="text-align: center;">
      <p class="section-label">Wanneer</p>
      <h2 class="section-title" id="tijden-heading">Openingstijden</h2>
      <div class="tijden-status">
        <OpenStatus />
      </div>
    </div>

    <ul class="tijden-list reveal" style="transition-delay: 0.1s;" aria-label="Openingstijden MIO Coffee & Desserts">
      {tijden.map(({ day, dag, tijd, gesloten }) => (
        <li class:list={['tijden-row', { gesloten, vandaag: day === vandaag }]} data-day={day}>
          <span class="tijden-dag">
            {dag}
            <span class="tijden-vandaag">vandaag</span>
          </span>
          <span class="tijden-dots" aria-hidden="true"></span>
          <span class="tijden-tijd">{tijd}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  #tijden {
    padding: 96px 0 100px;
    position: relative;
    background:
      radial-gradient(ellipse 50% 70% at 10% 50%, rgba(232, 212, 168, 0.3) 0%, transparent 60%),
      var(--cream-base);
  }

  .narrow { max-width: 680px; }

  #tijden .section-title { margin-bottom: 28px; }
  .tijden-status { margin-bottom: 44px; }

  .tijden-list { list-style: none; }

  .tijden-row {
    display: flex;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px dotted rgba(184, 149, 106, 0.45);
    gap: 12px;
  }
  .tijden-row:last-child { border-bottom: none; }

  .tijden-dag {
    font-family: var(--serif-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--brown-deep);
    min-width: 140px;
    flex-shrink: 0;
  }

  .tijden-dots {
    flex: 1;
    height: 1px;
    border-bottom: 1px dotted rgba(184, 149, 106, 0.5);
    margin-bottom: 3px;
    min-width: 20px;
  }

  .tijden-tijd {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.06em;
    color: var(--brown-text);
    text-align: right;
    white-space: nowrap;
  }

  .tijden-row.gesloten .tijden-dag {
    font-family: var(--serif-body);
    font-size: 15px;
    font-style: italic;
    letter-spacing: 0.08em;
    color: var(--brown-soft);
    text-transform: none;
  }
  .tijden-row.gesloten .tijden-tijd {
    color: var(--brown-soft);
    font-style: italic;
  }

  /* ----- Vandaag ----- */
  .tijden-vandaag {
    display: none;
    margin-left: 10px;
    font-family: var(--sans);
    font-size: 9px;
    font-weight: 500;
    font-style: normal;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--gold-rich);
    vertical-align: 1px;
  }
  .tijden-row.vandaag .tijden-vandaag { display: inline; }
  .tijden-row.vandaag .tijden-dag,
  .tijden-row.vandaag .tijden-tijd {
    color: var(--brown-deep);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .tijden-dag  { min-width: 110px; font-size: 12px; }
    .tijden-tijd { font-size: 12px; }
  }
</style>
