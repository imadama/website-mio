---
const items = [
  {
    naam: 'Koffie',
    omschrijving: 'Espresso, cappuccino en flat white — en seizoensspecials als de Pumpkin Spice Latte en Spanish Latte.',
  },
  {
    naam: 'Matcha',
    omschrijving: 'Van Matcha Original tot Banana Cloud en Crème Brûlée Matcha — romig, fris en met een dessertaccent.',
  },
  {
    naam: 'Bubble Tea & Mocktails',
    omschrijving: 'Negen fruitsmaken bubble tea, Brown Sugar Boba met tapioca en frisse mocktails als de Classic Mojito.',
  },
  {
    naam: 'Broodjes',
    omschrijving: 'L’Art du Pain — versgebakken broodjes op leisteen, van Bella Caprina tot Le Truffe Royal.',
  },
  {
    naam: 'Gebak & Macarons',
    omschrijving: 'Reuze macarons, luxe gebakjes, mini cheesecakes en de Cuore Fondente met vloeibaar chocoladehart.',
  },
  {
    naam: 'Wafels & Cookies',
    omschrijving: 'Les Gaufres d’Or met toppings naar keuze en warme skillet cookies met een bol ijs.',
  },
];
---
<section id="aanbod" aria-labelledby="aanbod-heading">
  <div class="section-inner">
    <div class="reveal">
      <p class="section-label">Proeven</p>
      <h2 class="section-title" id="aanbod-heading">Op de Kaart</h2>
    </div>

    <div class="aanbod-grid">
      {items.map((item, i) => (
        <div class="aanbod-item reveal" style={`transition-delay: ${0.05 * (i + 1)}s`}>
          <div class="aanbod-naam">{item.naam}</div>
          <p class="aanbod-omschrijving">{item.omschrijving}</p>
        </div>
      ))}
    </div>

    <p class="aanbod-cta reveal" style="transition-delay: 0.35s;">
      <a href="/menu" class="aanbod-link">Bekijk het volledige menu</a>
    </p>
  </div>
</section>

<style>
  #aanbod {
    padding: 96px 0 100px;
    position: relative;
    background:
      radial-gradient(ellipse 60% 60% at 80% 30%, rgba(201, 168, 118, 0.15) 0%, transparent 60%),
      var(--cream-base);
  }

  .aanbod-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  .aanbod-item {
    padding: 28px 0;
    border-bottom: 1px solid var(--line-gold);
  }
  .aanbod-item:nth-child(odd)  { padding-right: 40px; }
  .aanbod-item:nth-child(even) {
    padding-left: 40px;
    border-left: 1px solid var(--line-gold);
  }
  .aanbod-item:nth-last-child(-n+2) { border-bottom: none; }

  .aanbod-naam {
    font-family: var(--serif-display);
    font-size: clamp(15px, 1.8vw, 19px);
    font-weight: 400;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brown-deep);
    display: inline-block;
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(184, 149, 106, 0.4);
    margin-bottom: 8px;
  }

  .aanbod-omschrijving {
    font-family: var(--serif-body);
    font-size: clamp(15px, 1.5vw, 17px);
    font-weight: 300;
    font-style: italic;
    color: var(--brown-soft);
    line-height: 1.55;
  }

  .aanbod-cta {
    text-align: center;
    margin-top: 52px;
  }
  .aanbod-link {
    display: inline-block;
    padding-bottom: 6px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--brown-deep);
    text-decoration: none;
    border-bottom: 1px solid var(--gold-rich);
    transition: color 0.3s ease, border-color 0.3s ease;
  }
  .aanbod-link:hover { color: var(--gold-rich); }
  .aanbod-link:focus-visible { outline: 2px solid var(--gold-rich); outline-offset: 4px; }

  @media (max-width: 640px) {
    .aanbod-grid { grid-template-columns: 1fr; }
    .aanbod-item:nth-child(odd)  { padding-right: 0; }
    .aanbod-item:nth-child(even) {
      padding-left: 0;
      border-left: none;
    }
    .aanbod-item:nth-last-child(-n+2) { border-bottom: 1px solid var(--line-gold); }
    .aanbod-item:last-child { border-bottom: none; }
  }
</style>
