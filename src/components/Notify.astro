---
---
<section id="notify" aria-labelledby="notify-heading">
  <div class="section-inner narrow">
    <div class="reveal" style="text-align: center;">
      <p class="section-label">Op de Hoogte</p>
      <h2 class="section-title" id="notify-heading">Wees de Eerste</h2>
    </div>

    <p class="notify-intro reveal" style="transition-delay: 0.1s; text-align: center;">
      Wees de eerste die het weet wanneer we opengaan.
    </p>

    <div class="reveal" style="transition-delay: 0.2s;">
      <form class="notify-form" id="notifyForm" novalidate aria-label="Aanmeldformulier nieuwsbrief">
        <label for="notifyEmail" class="sr-only">E-mailadres</label>
        <input
          type="email"
          id="notifyEmail"
          class="notify-input"
          placeholder="uw e-mailadres"
          autocomplete="email"
          required
          aria-required="true"
        />
        <button type="submit" class="notify-btn">Houd mij op de hoogte</button>
      </form>
      <p class="notify-thanks" id="notifyThanks" role="status" aria-live="polite">
        Dank je — we laten je het weten.
      </p>
    </div>
  </div>
</section>

<script is:inline>
  document.getElementById('notifyForm').addEventListener('submit', async function (e) {
    e.preventDefault();
    var input = document.getElementById('notifyEmail');
    if (!input.value || !input.validity.valid) {
      input.focus();
      return;
    }
    var btn = this.querySelector('button');
    btn.disabled = true;
    try {
      var fd = new FormData();
      fd.append('email', input.value.trim());
      var res = await fetch('/api/subscribe', { method: 'POST', body: fd });
      if (res.ok) {
        this.style.display = 'none';
        document.getElementById('notifyThanks').style.display = 'block';
      } else {
        btn.disabled = false;
      }
    } catch {
      btn.disabled = false;
    }
  });
</script>

<style>
  #notify {
    padding: 96px 0 100px;
    text-align: center;
    position: relative;
    background:
      radial-gradient(ellipse 70% 60% at 50% 50%, rgba(201, 168, 118, 0.18) 0%, transparent 65%),
      var(--cream-base);
  }

  .narrow { max-width: 640px; }

  .notify-intro {
    font-family: var(--serif-body);
    font-size: clamp(18px, 2.2vw, 24px);
    font-weight: 300;
    font-style: italic;
    color: var(--brown-text);
    margin-bottom: 36px;
    line-height: 1.55;
  }

  .notify-form {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  .notify-input {
    flex: 1;
    min-width: 220px;
    padding: 14px 20px;
    background: var(--cream-soft);
    border: 1px solid var(--gold-rich);
    font-family: var(--sans);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--brown-text);
    outline: none;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .notify-input::placeholder { color: var(--brown-soft); opacity: 0.6; }
  .notify-input:focus {
    border-color: var(--champagne);
    box-shadow: 0 0 0 2px rgba(184, 149, 106, 0.2);
  }

  .notify-btn {
    padding: 14px 28px;
    background: var(--gold-rich);
    border: 1px solid var(--gold-rich);
    color: var(--cream-soft);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.35s ease, border-color 0.35s ease, letter-spacing 0.35s ease;
    white-space: nowrap;
  }
  .notify-btn:hover {
    background: var(--brown-deep);
    border-color: var(--brown-deep);
    letter-spacing: 0.42em;
  }
  .notify-btn:focus-visible {
    outline: 2px solid var(--gold-rich);
    outline-offset: 3px;
  }

  .notify-thanks {
    display: none;
    font-family: var(--serif-body);
    font-size: 18px;
    font-style: italic;
    color: var(--gold-rich);
    margin-top: 20px;
  }

  @media (max-width: 640px) {
    .notify-form    { flex-direction: column; }
    .notify-input,
    .notify-btn     { width: 100%; }
  }
</style>
