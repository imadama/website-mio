---
---
<section id="hero" aria-label="Openingspagina MIO Dessert Lounge">
  <p class="hero-eyebrow">Gorinchem &nbsp;·&nbsp; Binnenkort Geopend</p>

  <h1 class="hero-logo" aria-label="MIO">MIO</h1>

  <div class="hero-ornament ornament" aria-hidden="true">
    <span class="line" style="flex: 0 0 72px;"></span>
    <span class="diamond">✦</span>
    <span class="line" style="flex: 0 0 72px;"></span>
  </div>

  <p class="hero-tagline">Dessert Lounge</p>

  <p class="hero-sub">
    Coffee
    <span class="bullet" aria-hidden="true">✦</span>
    Gelato
    <span class="bullet" aria-hidden="true">✦</span>
    Desserts
  </p>

  <div class="hero-badge" role="status">Coming Soon</div>

  <div class="scroll-indicator" aria-hidden="true"></div>
</section>

<style>
  #hero {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 24px 80px;
    position: relative;
    background:
      radial-gradient(ellipse 80% 60% at 50% 0%, rgba(232, 212, 168, 0.5) 0%, transparent 65%),
      radial-gradient(ellipse 60% 50% at 80% 100%, rgba(201, 168, 118, 0.2) 0%, transparent 60%),
      radial-gradient(ellipse 50% 40% at 10% 60%, rgba(212, 185, 140, 0.15) 0%, transparent 55%),
      var(--cream-base);
  }

  .hero-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold-rich);
    opacity: 0;
    animation: fadeUp 0.9s ease forwards 0.2s;
  }

  .hero-logo {
    font-family: var(--serif-display);
    font-size: clamp(88px, 18vw, 160px);
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1;
    margin: 28px 0 4px;
    background: linear-gradient(135deg, #D4B98C 0%, #B8956A 25%, #E8D4A8 50%, #B8956A 75%, #8B6F47 100%);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    animation:
      fadeUp 1s ease forwards 0.55s,
      shimmer 6s ease-in-out infinite 1.6s;
  }

  .hero-ornament {
    margin: 16px 0 20px;
    opacity: 0;
    animation: fadeUp 0.9s ease forwards 0.9s;
  }

  .hero-tagline {
    font-family: var(--serif-body);
    font-size: clamp(16px, 2.4vw, 26px);
    font-weight: 400;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: var(--brown-deep);
    opacity: 0;
    animation: fadeUp 0.9s ease forwards 1.1s;
  }

  .hero-sub {
    margin-top: 22px;
    font-family: var(--serif-body);
    font-size: clamp(14px, 1.6vw, 18px);
    font-weight: 300;
    letter-spacing: 0.3em;
    color: var(--brown-soft);
    opacity: 0;
    animation: fadeUp 0.9s ease forwards 1.3s;
  }

  .hero-sub .bullet {
    color: var(--gold-rich);
    margin: 0 10px;
    font-size: 0.7em;
    vertical-align: middle;
  }

  .hero-badge {
    margin-top: 44px;
    display: inline-block;
    border: 1px solid var(--gold-rich);
    padding: 10px 32px;
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.5em;
    text-transform: uppercase;
    color: var(--gold-rich);
    opacity: 0;
    animation: fadeUp 0.9s ease forwards 1.5s;
  }

  .scroll-indicator {
    position: absolute;
    bottom: 36px;
    left: 50%;
    transform: translateX(-50%);
    width: 1px;
    height: 52px;
    background: linear-gradient(to bottom, transparent, var(--gold-rich));
    opacity: 0;
    animation:
      fade-in 0.6s ease forwards 2s,
      pulse-line 2.4s ease-in-out infinite 2.6s;
  }

  @media (max-width: 640px) {
    #hero { padding: 80px 24px 100px; }
  }
</style>
